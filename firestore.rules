rules_version = '2';
// Regras do servidor: valem mesmo que alguém mexa na tela.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && perfil().ativo != false; }
    function papel(lista) { return ativo() && perfil().papel in lista; }
    // O gestor (Fábio) só lê: nenhuma regra de gravação aceita o papel "gestor".
    function edita() { return ativo() && perfil().papel != "gestor"; }

    // Perfis: cada um lê o seu; só a dona cria e altera (tela Equipe).
    // Exceção única: a conta daiane@madalenas.app cria o próprio perfil de dona no primeiro acesso.
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || papel(["dona", "gestor"]));
      allow create: if papel(["dona"])
        || (logado() && request.auth.uid == uid
            && request.auth.token.email == "daiane@madalenas.app"
            && request.resource.data.papel == "dona");
      allow update: if papel(["dona"])
        // a própria pessoa só pode marcar que já trocou a senha provisória
        || (logado() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["trocarSenha"])
            && request.resource.data.trocarSenha == false);
      allow delete: if false;
    }

    // Presença do dia: líderes e dona marcam; dona e gestor leem tudo. Ninguém apaga.
    match /presenca/{id} {
      allow read: if papel(["dona", "gestor", "lider"]);
      allow create, update: if papel(["dona", "lider"])
        && request.resource.data.marcadoPorUid == request.auth.uid
        // Desfazer uma marcação: só a Daiane (10/11/2026).
        && (request.resource.data.situacao != "cancelado" || papel(["dona"]));
      allow delete: if false;
    }

    // Histórico: só se acrescenta. Ninguém altera nem apaga.
    match /presenca_historico/{id} {
      allow read: if papel(["dona"]);
      allow create: if papel(["dona", "lider"])
        && request.resource.data.marcadoPorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Livro de Ordens e Ocorrências: só se acrescenta. Correção é um registro novo.
    match /livro/{id} {
      allow read: if papel(["dona", "gestor", "lider"])
        || (ativo() && resource.data.tipo in ["ordem", "ciente", "feito", "cancelamento"]);
      allow create: if edita() && request.resource.data.autorUid == request.auth.uid && (
           request.resource.data.tipo in ["ciente", "feito"]
        // Cancelar um registro (ex.: era teste): líderes e a Daiane, sempre com motivo. Fica no livro.
        || (request.resource.data.tipo == "cancelamento" && papel(["dona", "lider"])
            && request.resource.data.motivo is string && request.resource.data.motivo.size() > 0)
        || (request.resource.data.tipo == "ordem" && papel(["dona"]))
        || (request.resource.data.tipo in ["ocorrencia", "passagem", "fechamento", "correcao"] && papel(["dona", "lider"]))
        || (request.resource.data.tipo == "visto" && papel(["dona"])));
      allow update, delete: if false;
    }

    // Consumo da equipe: caixa, líderes e gestão registram. Só se acrescenta; cancelamento é um registro novo.
    function caixaOuLider() { return papel(["dona", "gestor", "lider"]) || (ativo() && perfil().setor == "Caixa"); }
    function caixaOuLiderEdita() { return papel(["dona", "lider"]) || (edita() && perfil().setor == "Caixa"); }
    match /consumo/{id} {
      allow read: if caixaOuLider();
      allow create: if caixaOuLiderEdita()
        && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.tipo in ["consumo", "cancelamento"];
      allow update, delete: if false;
    }

    // Notas das empresas: caixa e líderes mandam a foto da nota assinada; conferir e anular só líderes e gestão.
    match /notas/{id} {
      allow read: if caixaOuLider();
      allow create: if caixaOuLiderEdita() && request.resource.data.registradoPorUid == request.auth.uid && (
           request.resource.data.tipo in ["nota", "pedido", "separado"]
        || (request.resource.data.tipo in ["conferido", "cancelado"] && papel(["dona", "lider"])));
    }
    // Cobrança e pagamento das empresas: só a dona registra; o gestor vê.
    match /cobrancas/{id} {
      allow read: if papel(["dona", "gestor"]);
      allow create: if papel(["dona"]) && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.tipo in ["cobranca", "pagamento", "cancelamento"];
      allow update, delete: if false;
    }
    // Fotos das notas assinadas (reduzidas no celular, até ~1 MB cada).
    // Perdas e sobras: qualquer pessoa ativa (menos o gestor) registra; cancelar é registro novo, só dona e líderes.
    match /perdas/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid && (
           request.resource.data.tipo == "perda"
        || (request.resource.data.tipo == "cancelamento" && papel(["dona", "lider"])));
      allow update, delete: if false;
    }
    match /perdas_fotos/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.foto is string && request.resource.data.foto.size() < 1000000;
      allow update, delete: if false;
    }

    // Produção do dia: produção e confeitaria registram (e a dona); o gestor só lê; cancelar só a dona.
    function daProducao() { return ativo() && perfil().setor in ["Produção", "Confeitaria"]; }
    match /producao/{id} {
      allow read: if papel(["dona", "gestor"]) || daProducao();
      allow create: if (papel(["dona"]) || (edita() && daProducao())) && request.resource.data.registradoPorUid == request.auth.uid && (
           request.resource.data.tipo == "producao"
        || (request.resource.data.tipo == "cancelamento" && papel(["dona"])));
      allow update, delete: if false;
    }

    // Limpeza da cozinha: quem faz registra com o próprio nome e foto. Só se acrescenta.
    match /cozinha/{id} {
      allow read: if papel(["dona", "gestor"]) || daProducao();
      allow create: if (papel(["dona"]) || (edita() && daProducao())) && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.tipo in ["antes", "depois", "feito"];
      allow update, delete: if false;
    }
    match /cozinha_fotos/{id} {
      allow read: if papel(["dona", "gestor"]) || daProducao();
      allow create: if (papel(["dona"]) || (edita() && daProducao())) && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.foto is string && request.resource.data.foto.size() < 1000000;
      allow update, delete: if false;
    }

    // Fichas técnicas: a produção preenche (cada envio é uma versão nova); só a dona aprova ou pede correção.
    match /fichas/{id} {
      allow read: if papel(["dona", "gestor"]) || daProducao();
      allow create: if request.resource.data.registradoPorUid == request.auth.uid && (
           (request.resource.data.tipo == "ficha" && (papel(["dona"]) || (edita() && daProducao())))
        || (request.resource.data.tipo in ["aprovacao", "correcao"] && papel(["dona"])));
      allow update, delete: if false;
    }
    match /fichas_fotos/{id} {
      allow read: if papel(["dona", "gestor"]) || daProducao();
      allow create: if (papel(["dona"]) || (edita() && daProducao())) && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.foto is string && request.resource.data.foto.size() < 1000000;
      allow update, delete: if false;
    }

    // Saídas do caixa (sangria, vale, diarista, compra, fornecedor, reforço): caixa, balcão e líderes registram; cancelar só dona e líderes.
    function caixaBalcao() { return caixaOuLider() || (ativo() && perfil().setor == "Balcão"); }
    function caixaBalcaoEdita() { return caixaOuLiderEdita() || (edita() && perfil().setor == "Balcão"); }
    match /caixa/{id} {
      allow read: if caixaBalcao();
      allow create: if caixaBalcaoEdita() && request.resource.data.registradoPorUid == request.auth.uid && (
           (request.resource.data.tipo == "movimento" && request.resource.data.valor is number && request.resource.data.valor > 0
            // Compra, fornecedor e feriado pago: só com autorização da Daiane ou do Fábio.
            && (!(request.resource.data.tipoMov in ["compra", "fornecedor", "feriado"]) || request.resource.data.autorizadoPor in ["Daiane", "Fábio"])
            // Sangria: no máximo R$ 600 por vez.
            && (request.resource.data.tipoMov != "sangria" || request.resource.data.valor <= 600))
        || (request.resource.data.tipo == "cancelamento" && papel(["dona", "lider"])));
      allow update, delete: if false;
    }
    match /caixa_fotos/{id} {
      allow read: if caixaBalcao();
      allow create: if caixaBalcaoEdita() && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.foto is string && request.resource.data.foto.size() < 1000000;
      allow update, delete: if false;
    }

    match /notas_fotos/{id} {
      allow read: if caixaOuLider();
      allow create: if caixaOuLiderEdita() && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.foto is string && request.resource.data.foto.size() < 1000000;
      allow update, delete: if false;
    }

    // Checklists: cada preenchimento é um registro novo. Os do caixa só caixa, líderes e gestão.
    match /checklists/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid
        && (!(request.resource.data.lista in ["caixa_abertura", "caixa_fechamento"]) || caixaOuLiderEdita())
        // Desfazer um checklist: só a Daiane (10/11/2026).
        && (request.resource.data.get("tipo", "") != "cancelamento" || papel(["dona"]));
      allow update, delete: if false;
    }

    // Fotos dos itens de checklist (prova do que foi feito).
    match /checklists_fotos/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.foto is string && request.resource.data.foto.size() < 1000000;
      allow update, delete: if false;
    }

    // Escala da semana: todos veem; só a Daiane monta (RH). Cada versão salva vai para o histórico.
    // Diárias (para pagamento de feriado): só a dona grava; caixa, balcão e líderes leem para pagar certo.
    match /diarias/{id} {
      allow read: if caixaBalcao();
      allow create, update: if papel(["dona"]) && request.resource.data.alteradoPorUid == request.auth.uid;
      allow delete: if false;
    }
    match /diarias_historico/{id} {
      allow read: if papel(["dona"]);
      allow create: if papel(["dona"]) && request.resource.data.alteradoPorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Salários: só a dona lê e grava. Folha do mês (vales, faltas, descontos lançados): só a dona.
    match /salarios/{id} {
      allow read: if papel(["dona"]);
      allow create, update: if papel(["dona"]) && request.resource.data.alteradoPorUid == request.auth.uid;
      allow delete: if false;
    }
    match /salarios_historico/{id} {
      allow read: if papel(["dona"]);
      allow create: if papel(["dona"]) && request.resource.data.alteradoPorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /folha/{id} {
      allow read: if papel(["dona"]);
      allow create: if papel(["dona"]) && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.tipo in ["lancamento", "cancelamento"];
      allow update, delete: if false;
    }

    // Estoque: toda a equipe ativa (menos o gestor) registra movimentos; cancelar só dona e líderes; lista de insumos só a dona.
    match /estoque/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid && (
           (request.resource.data.tipo == "mov" && request.resource.data.acao in ["entrada", "uso", "transferencia", "perda", "contagem"]
            && request.resource.data.qtd is number && request.resource.data.qtd >= 0)
        || (request.resource.data.tipo == "cancelamento" && papel(["dona", "lider"])));
      allow update, delete: if false;
    }
    match /estoque_fotos/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.foto is string && request.resource.data.foto.size() < 1000000;
      allow update, delete: if false;
    }
    // Item novo do estoque: qualquer pessoa da equipe cria (a Daiane arruma depois em Estoque → Insumos).
    match /estoque_insumos/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0
        && request.resource.data.unidade is string && request.resource.data.unidade.size() > 0;
      allow update, delete: if false;
    }
    match /estoque_cadastro/{id} {
      allow read: if ativo();
      allow create, update: if papel(["dona"]) && request.resource.data.alteradoPorUid == request.auth.uid;
      allow delete: if false;
    }
    match /estoque_cadastro_historico/{id} {
      allow read: if papel(["dona"]);
      allow create: if papel(["dona"]) && request.resource.data.alteradoPorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /escala/{semana} {
      allow read: if ativo();
      allow create, update: if papel(["dona"]) && request.resource.data.alteradoPorUid == request.auth.uid;
      allow delete: if false;
    }
    match /escala_historico/{id} {
      allow read: if papel(["dona"]);
      allow create: if papel(["dona"]) && request.resource.data.alteradoPorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Rodízio de tarefas do balcão: cada passo (foto antes, foto depois, feito) é um registro novo.
    match /tarefas/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.tipo in ["antes", "depois", "feito"];
      allow update, delete: if false;
    }
    match /tarefas_fotos/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.foto is string && request.resource.data.foto.size() < 1000000;
      allow update, delete: if false;
    }

    // Encomendas de clientes: toda a equipe anota, confere e avança a etapa. Só se acrescenta.
    match /encomendas/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid && (
           request.resource.data.tipo in ["encomenda", "conferida", "visto"]
        || (request.resource.data.tipo == "status" && request.resource.data.para in ["producao", "pronta", "entregue"])
        // Cancelar: toda a equipe pode (Daiane, 09/11/2026), sempre com o motivo.
        || (request.resource.data.tipo == "status" && request.resource.data.para == "cancelada"
            && request.resource.data.motivo is string && request.resource.data.motivo.size() > 0));
      allow update, delete: if false;
    }

    // Pedidos do balcão (mesas 1 a 6, balcão, viagem): toda a equipe vê a fila e lança; nada se altera nem se apaga.
    match /balcao/{id} {
      allow read: if ativo();
      allow create: if edita() && request.resource.data.registradoPorUid == request.auth.uid && (
           (request.resource.data.tipo == "pedido" && request.resource.data.itens is list && request.resource.data.itens.size() > 0)
        || (request.resource.data.tipo == "status" && request.resource.data.para in ["pronto", "entregue"])
        || (request.resource.data.tipo == "status" && request.resource.data.para == "cancelado"
            && request.resource.data.motivo is string && request.resource.data.motivo.size() > 0));
      allow update, delete: if false;
    }

    // Quem é da equipe (nomes, setor, função, rodízio): todos leem; só a Daiane troca. Cada versão vai para o histórico.
    match /config/{id} {
      allow read: if ativo();
      allow create, update: if papel(["dona"]) && request.resource.data.alteradoPorUid == request.auth.uid;
      allow delete: if false;
    }
    match /config_historico/{id} {
      allow read: if papel(["dona"]);
      allow create: if papel(["dona"]) && request.resource.data.alteradoPorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Qualquer outra coisa: bloqueada.
    match /{caminho=**} { allow read, write: if false; }
  }
}
