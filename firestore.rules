rules_version = '2';
// Regras do servidor: valem mesmo que alguém mexa na tela.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) && perfil().ativo != false; }
    function papel(lista) { return ativo() && perfil().papel in lista; }

    // Perfis: cada um lê o seu; só a dona cria e altera (tela Equipe).
    // Exceção única: a conta daiane@madalenas.app cria o próprio perfil de dona no primeiro acesso.
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || papel(["dona", "gestor"]));
      allow create: if papel(["dona"])
        || (logado() && request.auth.uid == uid
            && request.auth.token.email == "daiane@madalenas.app"
            && request.resource.data.papel == "dona");
      allow update: if papel(["dona"]);
      allow delete: if false;
    }

    // Presença do dia: líderes e dona marcam; dona e gestor leem tudo. Ninguém apaga.
    match /presenca/{id} {
      allow read: if papel(["dona", "gestor", "lider"]);
      allow create, update: if papel(["dona", "lider"])
        && request.resource.data.marcadoPorUid == request.auth.uid;
      allow delete: if false;
    }

    // Histórico: só se acrescenta. Ninguém altera nem apaga.
    match /presenca_historico/{id} {
      allow read: if papel(["dona"]);
      allow create: if papel(["dona", "lider"])
        && request.resource.data.marcadoPorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Livro de Ordens e Ocorrências: só se acrescenta. Correção é um registro novo.
    match /livro/{id} {
      allow read: if papel(["dona", "gestor", "lider"])
        || (ativo() && resource.data.tipo in ["ordem", "ciente", "feito"]);
      allow create: if ativo() && request.resource.data.autorUid == request.auth.uid && (
           request.resource.data.tipo in ["ciente", "feito"]
        || (request.resource.data.tipo == "ordem" && papel(["dona", "gestor"]))
        || (request.resource.data.tipo in ["ocorrencia", "passagem", "fechamento", "correcao"] && papel(["dona", "gestor", "lider"]))
        || (request.resource.data.tipo == "visto" && papel(["dona"])));
      allow update, delete: if false;
    }

    // Consumo da equipe: caixa, líderes e gestão registram. Só se acrescenta; cancelamento é um registro novo.
    function caixaOuLider() { return papel(["dona", "gestor", "lider"]) || (ativo() && perfil().setor == "Caixa"); }
    match /consumo/{id} {
      allow read: if caixaOuLider();
      allow create: if caixaOuLider()
        && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.tipo in ["consumo", "cancelamento"];
      allow update, delete: if false;
    }

    // Notas das empresas: caixa e líderes mandam a foto da nota assinada; conferir e anular só líderes e gestão.
    match /notas/{id} {
      allow read: if caixaOuLider();
      allow create: if caixaOuLider() && request.resource.data.registradoPorUid == request.auth.uid && (
           request.resource.data.tipo == "nota"
        || (request.resource.data.tipo in ["conferido", "cancelado"] && papel(["dona", "gestor", "lider"])));
      allow update, delete: if false;
    }
    // Fotos das notas assinadas (reduzidas no celular, até ~1 MB cada).
    match /notas_fotos/{id} {
      allow read: if caixaOuLider();
      allow create: if caixaOuLider() && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.foto is string && request.resource.data.foto.size() < 1000000;
      allow update, delete: if false;
    }

    // Checklists: cada preenchimento é um registro novo. Os do caixa só caixa, líderes e gestão.
    match /checklists/{id} {
      allow read: if ativo();
      allow create: if ativo() && request.resource.data.registradoPorUid == request.auth.uid
        && (!(request.resource.data.lista in ["caixa_abertura", "caixa_fechamento"]) || caixaOuLider());
      allow update, delete: if false;
    }

    // Encomendas de clientes: toda a equipe anota, confere e avança a etapa. Só se acrescenta.
    // Cancelar só dona, gestor e líderes.
    match /encomendas/{id} {
      allow read: if ativo();
      allow create: if ativo() && request.resource.data.registradoPorUid == request.auth.uid && (
           request.resource.data.tipo in ["encomenda", "conferida"]
        || (request.resource.data.tipo == "status" && request.resource.data.para in ["producao", "pronta", "entregue"])
        || (request.resource.data.tipo == "status" && request.resource.data.para == "cancelada" && papel(["dona", "gestor", "lider"])));
      allow update, delete: if false;
    }

    // Qualquer outra coisa: bloqueada.
    match /{caminho=**} { allow read, write: if false; }
  }
}
